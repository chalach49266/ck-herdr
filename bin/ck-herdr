#!/usr/bin/env python3
"""Small interactive ck-run transport for herdr-core. Python stdlib only."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import selectors
import shlex
import shutil
import subprocess
import sys
import time


ROOT = Path.home() / "PhD_local"
NAME = re.compile(r"[a-z0-9_-]{1,32}\Z")
BYPASS = {
    "--dangerously-bypass-approvals-and-sandbox",
    "--dangerously-bypass-hook-trust", "--dangerously-skip-permissions",
    "--allow-dangerously-skip-permissions", "--yolo", "--force", "-f",
    "--trust", "--approve-mcps",
}


def agent_command(config, alias):
    """Build an interactive argv; never copy a v1 print/exec invocation."""
    spec = config.get("aliases", {}).get(alias)
    if not isinstance(spec, dict):
        raise ValueError(f"unknown model alias: {alias}")
    agent = spec.get("agent")
    model, effort = spec.get("model"), spec.get("effort")
    # An argv-only command supports local fake fixtures. No shell evaluation.
    if "command" in spec:
        cmd = spec["command"]
        if not isinstance(cmd, list) or not cmd or not all(isinstance(x, str) for x in cmd):
            raise ValueError("alias command must be a nonempty string array")
        cmd = list(cmd)
    elif agent == "codex":
        cmd = ["codex", "--no-daemon", "--approve-for-me"]  # --approve-for-me = workspace-write sandbox + auto review; codex refuses it with --sandbox
        if model:
            cmd += ["-m", model]
        if effort in config.get("_verified", {}).get("codex", {}).get("efforts", []):
            cmd += ["-c", f'model_reasoning_effort="{effort}"']
    elif agent in ("claude", "cursor", "agy"):
        cmd = [{"claude": "claude", "cursor": "agent", "agy": "agy"}[agent]]
        if agent == "cursor":
            cmd += ["--auto-review", "--sandbox", "enabled"]
        if model:
            cmd += ["--model", model]
        if effort in config.get("_verified", {}).get(agent, {}).get("efforts", []):
            cmd += ["--effort", effort]
    else:
        raise ValueError(f"unsupported agent: {agent!r}")

    safe, dropped = [], []
    i = 0
    while i < len(cmd):
        arg = cmd[i]
        flag, _, value = arg.partition("=")
        if flag in BYPASS or flag.startswith("--dangerously-"):
            dropped.append(arg)
        elif flag in ("--permission-mode", "--ask-for-approval", "-a", "--sandbox"):
            separate = "=" not in arg
            value = cmd[i + 1] if separate and i + 1 < len(cmd) else value
            if value in ("bypassPermissions", "never", "danger-full-access", "disabled"):
                dropped.append(arg + (" " + value if separate else ""))
                i += int(separate)
            else:
                safe.append(arg)
                if separate:
                    safe.append(value)
                    i += 1
        elif flag in ("-c", "--config") and not (
            i + 1 < len(cmd) and re.fullmatch(
                r'model_reasoning_effort="(?:low|medium|high|xhigh|max)"', cmd[i + 1]
            )
        ):
            raise ValueError("only model_reasoning_effort config overrides are supported")
        elif flag in ("-p", "--print", "--prompt", "--output-format", "--input-format") or arg in ("exec", "review"):
            raise ValueError("alias command must be interactive, with no print/exec flags")
        else:
            safe.append(arg)
        i += 1
    if not safe or safe[0].startswith("-"):
        raise ValueError("alias has no executable")
    if Path(safe[0]).name == "codex" and "--no-daemon" not in safe:
        safe.append("--no-daemon")
    if Path(safe[0]).name == "agy":
        safe.append("--prompt-interactive")
    return safe, dropped


def hc_path():
    return os.environ.get("CK_HERDR_HC") or shutil.which("hc") or str(Path.home() / ".local/bin/hc")


def app_path():
    return os.environ.get("CK_HERDR_APP") or shutil.which("herdr-app") or str(Path.home() / ".local/bin/herdr-app")


def space_label(name, log):
    """Opt into the running window; window failures must not block agents."""
    app = app_path()

    def lookup():
        spaces = invoke([app, "ls"], log)["spaces"]
        return next((s["id"] for s in spaces if s.get("name") == name), None)

    try:
        # All launches from this installation share one advisory lock. Keep the
        # file: unlinking a lock can let concurrent processes lock different inodes.
        lock_path = Path(__file__).resolve().parents[1] / ".space.lock"
        with lock_path.open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            space = lookup()
            if not space:
                invoke([app, "do", "space.new", "--name", name,
                        "--folder", str(ROOT / "agent_runs")], log)
                space = lookup()
        if not isinstance(space, str) or not space:
            raise ValueError("space has no ID")
        return ["--label", f"herdr.space={space}"]
    except (OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired):
        warning = "ck-herdr: warning: Herdr window unavailable; launching without a space label"
        print(warning, file=sys.stderr)
        log.write(warning + "\n")
        return []


def home_pane(main, log):
    """The Herdr space/tab/pane that shows terminal `main` (the agent that launches), or None."""
    try:
        for space in invoke([app_path(), "ls"], log)["spaces"]:
            for tab in space.get("tabs", []):
                for term in tab.get("terminals", []):
                    if term.get("terminal") == main:
                        return space["id"], tab["id"], term.get("pane")
    except (OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired):
        pass
    return None


def doc_rpc(method, params):
    """One JSON-RPC call to herdr-core (hc connect). The app keeps its splits in the doc 'herdr-app'."""
    req = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params}) + "\n"
    proc = subprocess.run([hc_path(), "connect", "--json"], input=req, capture_output=True, text=True, timeout=15)
    for line in proc.stdout.splitlines():
        try:
            data = json.loads(line)
        except ValueError:
            continue
        if data.get("id") == 1:
            if "error" in data:
                raise ValueError(f"{method}: {data['error']}")
            return data["result"]
    raise ValueError(f"{method}: no reply from hc connect (exit {proc.returncode})")


def _leaves(node):
    if node.get("type") == "block" and isinstance(node.get("content"), dict) and node["content"].get("terminal"):
        yield node
    for child in node.get("children", []):
        yield from _leaves(child)


def _node_id():
    return "s" + os.urandom(16).hex()


def beside_tree(root, main, agents):
    """The tab's new split tree: main on the left half, the agents stacked in the right half, equal sizes.
    Other panes in the tab stay, under main in the left half. None when main is not in the tab."""
    leaves = list(_leaves(root))
    main_leaf = next((leaf for leaf in leaves if leaf["content"]["terminal"] == main), None)
    right = [leaf for leaf in leaves if leaf["content"]["terminal"] in agents]
    if main_leaf is None or not right:
        return None
    others = [leaf for leaf in leaves if leaf is not main_leaf and leaf not in right]
    one = {"weight": 1.0}
    left = dict(main_leaf, size=one)
    if others:
        left = {"type": "column", "id": _node_id(), "size": one,
                "children": [dict(leaf, size=one) for leaf in [main_leaf, *others]]}
    column = {"type": "column", "id": _node_id(), "size": one,
              "children": [dict(leaf, size=one) for leaf in right]}
    return {"type": "row", "id": root["id"], "children": [left, column]}


def arrange_beside(tab_id, main, new, log, timeout=20.0):
    """Wait until Herdr shows terminal `new` in tab `tab_id`, then lay the tab out: main left half, every
    ck-herdr agent of this main (label ck.main=<main>) in the right half, equal heights. The doc write is
    version-checked (a conflict re-reads and retries). Returns True when the layout was written."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        doc = doc_rpc("doc.get", {"name": "herdr-app"})
        value = doc.get("value") or {}
        tab = next((t for s in value.get("spaces", []) for t in s.get("tabs", []) if t.get("id") == tab_id), None)
        if tab is None:
            raise ValueError(f"tab {tab_id} not found in the Herdr doc")
        if new not in {leaf["content"]["terminal"] for leaf in _leaves(tab["root"])}:
            time.sleep(0.4)  # the app has not adopted the new terminal yet
            continue
        listed = invoke([hc_path(), "ls", "--json", "--label", f"ck.main={main}"])
        agents = {t["address"] for t in listed.get("terminals", [])} | {new}
        tree = beside_tree(tab["root"], main, agents)
        if tree is None:
            return False
        tab["root"] = tree
        try:
            doc_rpc("doc.set", {"name": "herdr-app", "value": value, "version": doc["version"]})
        except ValueError as exc:
            if "conflict" in str(exc):
                continue  # somebody else changed the layout: read again
            raise
        log.write(f"ck-herdr: layout: {main} left half, {len(agents)} agent pane(s) right half, equal sizes\n")
        return True
    raise ValueError(f"Herdr did not show terminal {new} in the main tab within {timeout:.0f} s")


def invoke(argv, log=None, timeout=30):
    if log:
        log.write("$ " + shlex.join(argv) + "\n")
        log.flush()
    proc = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    if log:
        log.write(proc.stdout)
        log.write(proc.stderr)
        log.flush()
    # hc wait may return a terminal exit/blocked code with useful JSON.
    try:
        data = json.loads(proc.stdout)
    except ValueError:
        raise ValueError(f"hc returned no JSON (exit {proc.returncode}): {proc.stderr.strip()}")
    if isinstance(data, dict) and "error" in data:
        raise ValueError(str(data["error"]))
    if proc.returncode and not (isinstance(data, dict) and "reason" in data and "ended" in data):
        raise ValueError(f"hc failed (exit {proc.returncode}): {proc.stderr.strip()}")
    return data


def outcome(wait):
    if wait.get("reason") == "status":
        if wait.get("status") == "idle" and wait.get("turn", 0) > 0:
            return 0, "done"
        return {"done": (0, "done"), "blocked": (1, "blocked"),
                "idle": (1, "partial")}.get(wait.get("status"), (3, "error"))
    return 3, wait.get("reason", "error")


def wait_for_task(argv, log, timeout, cursor=False):
    """Consume hc facts, including startup idle, without reading screen text.

    hc wait returns immediately on startup idle. Its event subscription gives
    an atomic snapshot followed by changes, so no completed turn is missed
    between launch and subscription. turn increments when working ends.
    """
    log.write("$ " + shlex.join(argv) + "\n")
    terminal = {}
    saw_working = False
    deadline = time.monotonic() + timeout
    with subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE) as proc:
        try:
            with selectors.DefaultSelector() as selector:
                selector.register(proc.stdout, selectors.EVENT_READ)
                pending = b""
                while True:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0 or not selector.select(remaining):
                        if cursor and not saw_working:
                            return 2, "unknown"
                        idle = (terminal.get("status") or {}).get("state") == "idle"
                        return (1, "partial") if idle else (3, "timeout")
                    chunk = os.read(proc.stdout.fileno(), 65536)
                    if not chunk:
                        raise ValueError("hc event stream closed before completion")
                    pending += chunk
                    while b"\n" in pending:
                        line, pending = pending.split(b"\n", 1)
                        log.write(line.decode("utf-8", errors="replace") + "\n")
                        data = json.loads(line)
                        if "error" in data:
                            raise ValueError(str(data["error"]))
                        if data.get("method") == "missed":
                            raise ValueError("hc missed status events; completion is unverified")
                        if "terminals" in data:
                            # Initial atomic snapshot includes already completed turns.
                            matches = data["terminals"]
                            if len(matches) != 1:
                                raise ValueError("hc subscription has no unique terminal")
                            terminal = matches[0]
                            saw_working = False
                        elif data.get("method") == "event":
                            event = data["params"]
                            if event.get("terminal") != terminal.get("address"):
                                continue
                            kind, facts = event.get("type"), event.get("data", {})
                            if kind == "finished":
                                return 3, "exit"
                            if kind == "removed":
                                return 3, "error"
                            if kind in ("lost", "restarted"):
                                return 3, "error"
                            if kind == "status":
                                terminal["status"] = facts.get("status")
                            elif kind == "turn":
                                terminal["turn"] = facts["turn"]
                        else:
                            continue  # Heartbeats carry no completion evidence.
                        if terminal.get("state") == "finished":
                            return 3, "exit"
                        state = (terminal.get("status") or {}).get("state")
                        if state == "working":
                            saw_working = True
                        if state == "idle" and saw_working:
                            return 0, "done"
                        if state in ("done", "blocked", "error") or (
                                state == "idle" and terminal.get("turn", 0) > 0):
                            return outcome({"reason": "status", "status": state,
                                            "turn": terminal.get("turn", 0)})
        finally:
            # Stop only our event reader; never interrupt the agent terminal.
            if proc.poll() is None:
                proc.terminate()
            proc.communicate(timeout=5)


def launch(args):
    if not NAME.fullmatch(args.slug):
        raise ValueError("slug must be lowercase letters, digits, '-' or '_', length 1..32 (hc names)")
    runs = Path(os.environ.get("CK_HERDR_RUNS_DIR", str(ROOT / "agent_runs"))).expanduser().resolve()
    models = Path(os.environ.get("CK_HERDR_MODELS", str(ROOT / "ck-dispatch/config/models.json"))).expanduser()
    config = json.loads(models.read_text())
    cmd, dropped = agent_command(config, args.model)
    cursor = config["aliases"][args.model].get("agent") == "cursor"
    wait_timeout = float(os.environ.get("CK_HERDR_WAIT_TIMEOUT", "180"))
    if not 0 < wait_timeout < float("inf"):
        raise ValueError("CK_HERDR_WAIT_TIMEOUT must be finite and positive")
    cwd = Path(args.cwd).expanduser().resolve()
    if not cwd.is_dir():
        raise ValueError(f"cwd is not a directory: {cwd}")
    prompt = runs / f"{args.slug}_prompt.md"
    out = runs / f"{args.slug}.out"
    task = f"Task: read the prompt file {json.dumps(str(prompt))} and follow its task, scope, and output contract."
    if args.title:
        task += f" Title: {args.title}."
    task += " Do not start additional agents."
    run_folder = runs / args.slug
    wrapper = Path(__file__).resolve().with_name("ck-herdr-cursor")
    wrapped = cursor and wrapper.is_file()
    if cursor:
        task += (
            " OUTPUT CONTRACT (required): LIVE RUN: ck-run cannot read your replies in this session. "
            "It reads two files in your run folder. "
            f"OUTBOX: {run_folder}. When you are finished: "
            f"1. Write {run_folder}/result.md: your full answer in Markdown. "
            f"2. Then write {run_folder}/summary.md: only the summary lines, one per line "
            "(1 to 10 short lines). Write it LAST: ck-run takes this file as the sign that you are done. "
            "These two output writes are authorized even for a read-only task; keep all other scope limits. "
            "Do not write summary.md until the task and result.md are finished."
        )
    hc = hc_path()
    main = os.environ.get("HC_TERMINAL_ID", "")
    place = args.place or ("beside" if main else "tab")
    if place == "beside" and not main:
        raise ValueError("--place beside needs HC_TERMINAL_ID (run it from an agent inside Herdr)")
    run_cmd = [hc, "run", "--json", "--bg", "--outlive-parent", "--name", args.slug,
               "--cwd", str(cwd), "--label", "ck-herdr=true"]
    if place == "beside":
        run_cmd += ["--label", f"ck.main={main}"]
    program = [sys.executable, str(wrapper), str(run_folder), "--"] if wrapped else []
    agent_args = ["--", *program, *cmd, task]
    labels = [hc, "label", "--json", args.slug, f"ask={args.ask or ''}", f"model={args.model}"]
    wait_cmd = [hc, "events", "--json", "--terminal", args.slug]
    read_cmd = [hc, "read", "--lines", "100", args.slug]
    for flag in dropped:
        print(f"ck-herdr: dropped unsafe v1 flag: {flag}", file=sys.stderr)
    if args.dry_run:
        print("dry run: nothing written or started")
        print("space lookup: " + shlex.join([app_path(), "ls"]) + f" (name={args.space!r})")
        print("if missing: " + shlex.join([app_path(), "do", "space.new", "--name", args.space,
                                            "--folder", str(ROOT / "agent_runs")]))
        print("if the window is unavailable: launch without the space label and warn")
        if place == "beside":
            print(f"place: beside the main agent {main}: its Herdr tab; main left half, agents stacked "
                  "in the right half with equal sizes (version-checked write of the 'herdr-app' doc)")
            planned_run = run_cmd + ["--label", "herdr.space=<main's space>", "--label", "herdr.tab=<main's tab>"]
        else:
            planned_run = run_cmd + ["--label", "herdr.space=<resolved-space-id>"]
        planned_run += agent_args
        for line in (planned_run, labels):
            print(shlex.join(line))
        print(shlex.join(wait_cmd))
        if cursor:
            print(f"run folder: {run_folder} (created only on live launch)")
            print("completion: tty wrapper watches result.md then stable summary.md; unknown only if wrapper unavailable")
        print(shlex.join(read_cmd))
        print(f"out: {out} (final line: ck-run exit=<N>)")
        return 0
    if not prompt.is_file():
        raise ValueError(f"missing prompt file: {prompt}")
    # Refuse reused slugs atomically, including symlinks, so no prior log is overwritten.
    with out.open("x", buffering=1) as log:
        code, status = 3, "error"
        log.write(f"ck-herdr: slug={args.slug} model={args.model} ask={args.ask or ''}\n")
        for flag in dropped:
            log.write(f"ck-herdr: dropped unsafe v1 flag: {flag}\n")
        try:
            if cursor:
                run_folder.mkdir()  # Never accept a stale summary from a reused folder.
                if not wrapped:
                    log.write("ck-herdr: warning: Cursor wrapper unavailable; status may be unknown; read the tab\n")
            home = home_pane(main, log) if place == "beside" else None
            if place == "beside" and home is None:
                log.write(f"ck-herdr: warning: main agent {main} is not in a Herdr tab; using a tab in space "
                          f"{args.space}\n")
            if home:
                # One launch at a time places and arranges, so parallel launches all land in the right column.
                lock_path = Path(__file__).resolve().parents[1] / ".space.lock"
                with lock_path.open("a") as lock:
                    fcntl.flock(lock, fcntl.LOCK_EX)
                    started = invoke(run_cmd + ["--label", f"herdr.space={home[0]}", "--label",
                                                f"herdr.tab={home[1]}"] + agent_args, log)
                    try:
                        arrange_beside(home[1], main, started.get("address") or args.slug, log)
                    except (OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired) as exc:
                        log.write(f"ck-herdr: warning: could not arrange the panes ({exc}); the agent runs anyway\n")
            else:
                started = invoke(run_cmd + space_label(args.space, log) + agent_args, log)
            first = started.get("first_message") or {}
            if first.get("sent") is False:
                raise ValueError(f"initial task was not sent: {first}")
            invoke(labels, log)
            code, status = wait_for_task(wait_cmd, log, wait_timeout, cursor=cursor)
            if cursor and status == "unknown":
                log.write("ck-herdr: status=unknown; no Cursor completion status arrived; "
                          f"read the tab: hc attach {args.slug}\n")
            screen = subprocess.run(read_cmd, capture_output=True, text=True, timeout=30)
            log.write(screen.stdout)
            log.write(screen.stderr)
            if screen.returncode:
                code, status = 3, "error (could not collect terminal output)"
        except (OSError, ValueError, subprocess.TimeoutExpired, KeyboardInterrupt) as exc:
            code, status = 3, "error"
            log.write(f"ck-herdr: error: {exc}\n")
        finally:
            # The Herdr tab/pane circle (ck-tabs, ck-pane mods): green done, yellow needs you, red failed.
            # A label stays after chalach looks (Herdr's own "done" turns "idle" then).
            state = {0: "done", 1: "needs", 2: "needs"}.get(code, "failed")
            try:
                subprocess.run([hc_path(), "label", "--json", args.slug, f"ck.state={state}"],
                               capture_output=True, text=True, timeout=15)
                log.write(f"ck-herdr: ck.state={state}\n")
            except (OSError, subprocess.TimeoutExpired):
                pass
            log.write(f"ck-run: status={status} slug={args.slug} (Herdr terminal retained; attach with hc attach {args.slug})\n")
            log.write(f"ck-run exit={code}\n")
    print(out)
    return code


def listing(args):
    cmd = [hc_path(), "ls", "--json", "--label", "ck-herdr=true"]
    if args.dry_run:
        print(shlex.join(cmd))
        return 0
    data = invoke(cmd)
    print("SLUG\tTERMINAL\tSTATE\tSTATUS\tASK\tMODEL\tCWD")
    for terminal in data.get("terminals", []):
        # hc ls returns compact rows; hc get carries the actual label map.
        if "labels" not in terminal:
            terminal = invoke([hc_path(), "get", "--json", terminal["address"]])
        if terminal.get("labels", {}).get("ck-herdr") != "true":
            continue
        labels = terminal["labels"]
        row = (terminal.get("name"), terminal.get("address"), terminal.get("state"),
               (terminal.get("status") or {}).get("state"), labels.get("ask"),
               labels.get("model"), terminal.get("cwd"))
        print("\t".join(str(x or "-").replace("\n", " ").replace("\t", " ") for x in row))
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dry-run", action="store_true", help="print commands; do not write or start anything")
    commands = parser.add_subparsers(dest="command", required=True)
    launch_parser = commands.add_parser("launch")
    launch_parser.add_argument("slug")
    launch_parser.add_argument("--model", required=True)
    launch_parser.add_argument("--cwd", required=True)
    launch_parser.add_argument("--ask")
    launch_parser.add_argument("--title")
    launch_parser.add_argument("--space", default="CK", help="Herdr space name for --place tab (default: CK)")
    launch_parser.add_argument("--place", choices=("beside", "tab"),
                               help="beside: a pane in the launching agent's tab (main left half, agents right "
                                    "half, equal sizes); tab: a new tab in --space. Default: beside inside Herdr "
                                    "(HC_TERMINAL_ID set), else tab")
    ls_parser = commands.add_parser("ls")
    for sub in (launch_parser, ls_parser):
        sub.add_argument("--dry-run", action="store_true", default=argparse.SUPPRESS)
    args = parser.parse_args()
    try:
        return launch(args) if args.command == "launch" else listing(args)
    except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
        print(f"ck-herdr: {exc}", file=sys.stderr)
        return 3


if __name__ == "__main__":
    sys.exit(main())
