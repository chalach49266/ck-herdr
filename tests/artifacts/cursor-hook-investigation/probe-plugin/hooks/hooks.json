{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 \"$CURSOR_PLUGIN_ROOT/hooks/probe.py\" sessionStart"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 \"$CURSOR_PLUGIN_ROOT/hooks/probe.py\" beforeSubmitPrompt"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "python3 \"$CURSOR_PLUGIN_ROOT/hooks/probe.py\" afterAgentResponse"
      }
    ],
    "stop": [
      {
        "command": "python3 \"$CURSOR_PLUGIN_ROOT/hooks/probe.py\" stop"
      }
    ]
  }
}
